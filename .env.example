# Local settings for `docker compose up`. Copy to .env (which git ignores): cp .env.example .env

# Seed the demo project and users taylor / jordan / casey / morgan (password: devpassword).
# Only happens when the database has no projects yet. Never set this on staging or production.
SEED_DEMO_DATA=true

# Change these if something else on your machine already uses the port.
APP_PORT=8080
DB_PORT=5432

# Optional: turn on the AI features locally (see README "Configuration").
# ANALYSIS_LLM_BASE_URL=
# ANALYSIS_LLM_API_KEY=
# ANALYSIS_LLM_MODEL=
# REVIEW_LLM_BASE_URL=
# REVIEW_LLM_API_KEY=
# REVIEW_LLM_MODEL=
# GITHUB_TOKEN=
