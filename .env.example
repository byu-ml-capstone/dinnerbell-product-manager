# Local settings for `docker compose up`. Copy to .env (which git ignores): cp .env.example .env

# Seed the demo project and users taylor / jordan / casey / morgan (password: devpassword).
# Only happens when the database has no projects yet. Never set this on staging or production.
SEED_DEMO_DATA=true

# Change these if something else on your machine already uses the port.
APP_PORT=8080
DB_PORT=5432

# AI-7: set each feature's provider, model and key explicitly in your ignored .env
ANALYSIS_LLM_BASE_URL=
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_MODEL=
# Use none to omit reasoning_effort for models such as the classroom-chat proxy
# Blank effort and token limits use backend defaults: medium / 4096
ANALYSIS_LLM_REASONING_EFFORT=
ANALYSIS_LLM_MAX_OUTPUT_TOKENS=

# Empty review base URL uses OpenAI directly
REVIEW_LLM_BASE_URL=
REVIEW_LLM_API_KEY=
REVIEW_LLM_MODEL=
# Blank effort and token limits use backend defaults: high / 6000
REVIEW_LLM_REASONING_EFFORT=
REVIEW_LLM_MAX_OUTPUT_TOKENS=
GITHUB_TOKEN=
