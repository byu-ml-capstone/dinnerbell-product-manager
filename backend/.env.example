DATABASE_URL=postgresql+psycopg://appuser:apppass@localhost:5432/appdb
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Denver
# The class deploy is HTTP only, so the session cookie can't be Secure there.
SESSION_COOKIE_SECURE=false
# Local development only: seeds taylor/jordan/casey/morgan (password "devpassword") and a demo project.
SEED_DEMO_DATA=false

# Sprint analysis: explicitly configure the class LiteLLM proxy (AI-7)
ANALYSIS_LLM_BASE_URL=
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_MODEL=
# Blank effort and token limits use backend defaults: medium / 4096
# Use none for the classroom-chat proxy, which does not support reasoning_effort
ANALYSIS_LLM_REASONING_EFFORT=
ANALYSIS_LLM_MAX_OUTPUT_TOKENS=

# Sprint review: Responses with tools, direct OpenAI or an explicit proxy
REVIEW_LLM_BASE_URL=
REVIEW_LLM_API_KEY=
REVIEW_LLM_MODEL=
# Blank effort and token limits use backend defaults: high / 6000
REVIEW_LLM_REASONING_EFFORT=
REVIEW_LLM_MAX_OUTPUT_TOKENS=

# Fine-grained, read-only token for the project's repo (Contents, Pull requests, Metadata: read).
GITHUB_TOKEN=
