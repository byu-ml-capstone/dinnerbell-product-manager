DATABASE_URL=postgresql+psycopg://appuser:apppass@localhost:5432/appdb
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Denver
# The class deploy is HTTP only, so the session cookie can't be Secure there.
SESSION_COOKIE_SECURE=false
# Local development only: seeds taylor/jordan/casey/morgan (password "devpassword") and a demo project.
SEED_DEMO_DATA=false

# Shared key for direct OpenAI calls; explicit area keys override it
OPENAI_API_KEY=

# Sprint analysis: OpenAI by default, or an explicitly configured class proxy
ANALYSIS_LLM_BASE_URL=https://api.openai.com/v1
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_MODEL=gpt-6-luna
ANALYSIS_LLM_REASONING_EFFORT=medium
ANALYSIS_LLM_MAX_OUTPUT_TOKENS=4096

# Sprint review: Responses with tools, direct OpenAI or an explicit proxy
REVIEW_LLM_BASE_URL=
REVIEW_LLM_API_KEY=
REVIEW_LLM_MODEL=gpt-6-luna
REVIEW_LLM_REASONING_EFFORT=high
REVIEW_LLM_MAX_OUTPUT_TOKENS=6000

# Fine-grained, read-only token for the project's repo (Contents, Pull requests, Metadata: read).
GITHUB_TOKEN=
